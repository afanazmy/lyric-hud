{
  "manifest_version": 3,
  "name": "Lyric HUD Bridge",
  "version": "0.1.0",
  "description": "Mengirim info lagu dari Spotify Web / YouTube Music ke app Lyric HUD di Mac, dan menerima perintah play/pause/next/previous.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
